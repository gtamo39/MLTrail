registry.json
*.joblib
*.pkl
*.parquet
*.sdf
*.csv
*.xlsx

# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/

# Local editor / OS junk
.DS_Store
.vscode/
.idea/

# Claude Code per-machine settings
.claude/settings.local.json
